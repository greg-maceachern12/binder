# Public client. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only. Supabase service_role key (Dashboard → Project Settings → API).
# Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, and never import
# src/app/lib/supabase/admin.ts from a client component.
# Add this on the host before deploying. Course generation fails without it
# once the interim syllabi/chapters/lessons write policies are dropped.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-only. Used by syllabus and lesson generation.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Public.
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
